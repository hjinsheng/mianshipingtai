<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mianshipingtai.mapper.UserSignInMapper">

    <resultMap id="BaseResultMap" type="com.mianshipingtai.model.entity.UserSignIn">
        <id property="id"         column="id"         jdbcType="BIGINT"/>
        <result property="userId"     column="userId"     jdbcType="BIGINT"/>
        <result property="signInDate" column="signInDate" jdbcType="DATE"/>
        <result property="year"       column="year"       jdbcType="INTEGER"/>
        <result property="createTime" column="createTime" jdbcType="TIMESTAMP"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, userId, signInDate, year, createTime
    </sql>

    <insert id="batchInsert" parameterType="java.util.List">
        INSERT IGNORE INTO user_sign_in (id, userId, signInDate, year, createTime)
        VALUES
        <foreach collection="list" item="item" separator=",">
            (#{item.id}, #{item.userId}, #{item.signInDate}, #{item.year}, #{item.createTime})
        </foreach>
    </insert>

</mapper>